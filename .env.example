# 环境变量配置示例文件
# 复制此文件为 .env 并填入实际配置

# ========== 数据库配置 ==========
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# ========== 阿里云 OSS 配置 ==========
# AccessKey ID（在阿里云控制台获取）
OSS_ACCESS_KEY_ID=your_access_key_id

# AccessKey Secret（在阿里云控制台获取）
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# OSS Endpoint（地域节点，例如：oss-cn-hangzhou.aliyuncs.com）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# Bucket 名称
OSS_BUCKET_NAME=your_bucket_name

# 自定义域名（可选，如果配置了CDN加速域名）
# 如果不配置，将使用默认的 Bucket 域名
OSS_BASE_URL=

# OSS 中的上传目录（可选，默认为 凯凯和甜甜KT/）
OSS_UPLOAD_DIR=uploads/

# ========== 阿里云 OSS 配置说明 ==========
# 1. 登录阿里云控制台: https://oss.console.aliyun.com/
# 2. 创建 Bucket（选择合适的地域和存储类型）
# 3. 设置 Bucket 权限为"公共读"（允许匿名访问图片）
# 4. 获取 AccessKey：https://ram.console.aliyun.com/manage/ak
# 5. 可选：配置 CDN 加速域名以提升访问速度