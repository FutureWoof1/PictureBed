# ========== 图床配置 ==========
# 图床类型: smms, imgbb, imgur
IMAGE_BED_TYPE=smms

# API密钥（根据图床类型填写）
# SM.MS: 可选，不填也能使用但有限制
# ImgBB: 必填，在 https://api.imgbb.com/ 注册获取
# Imgur: 必填，在 https://api.imgur.com/ 注册获取Client ID
IMAGE_BED_API_KEY=

# ========== 图床服务说明 ==========
# 1. SM.MS (推荐，免费)
#    - 无需注册即可使用（有上传限制）
#    - 注册后获取API Token可提升限制
#    - 官网: https://sm.ms/
#
# 2. ImgBB
#    - 需要注册获取API Key
#    - 免费版每月有上传限制
#    - 官网: https://api.imgbb.com/
#
# 3. Imgur
#    - 需要注册获取Client ID
#    - 免费版有速率限制
#    - 官网: https://api.imgur.com/